        android:usesCleartextTraffic="true"
        android:label="@string/debug_app_name"
        android:icon="@mipmap/ic_launcher_debug"
        android:roundIcon="@mipmap/ic_launcher_debug"
        tools:replace="android:label,android:icon,android:roundIcon" />
</manifest>
