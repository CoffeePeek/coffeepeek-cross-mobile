PRODUCT_NAME = CoffeePeek
PRODUCT_BUNDLE_IDENTIFIER = com.coffeepeek
CODE_SIGN_ENTITLEMENTS = iosApp/CoffeePeek.entitlements
MARKETING_VERSION = 1.1.2
// Preserve published build codes when counting only the current branch history.
BUILD_NUMBER_OFFSET = 1000
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 18.0
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64

// xcconfig treats // as a comment, so $() keeps the URL intact.
API_BASE_URL = https:/$()/api.coffeepeek.by
GOOGLE_IOS_CLIENT_ID =
GOOGLE_WEB_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID = coffeepeek-google-signin-disabled

// Explicit local opt-in for analytics in Debug builds.
POSTHOG_ENABLE_DEV = NO
POSTHOG_PROJECT_TOKEN =

#include? "Local.xcconfig"
