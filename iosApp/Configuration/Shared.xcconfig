PRODUCT_NAME = CoffeePeek
PRODUCT_BUNDLE_IDENTIFIER = com.coffeepeek
CODE_SIGN_ENTITLEMENTS = iosApp/CoffeePeek.entitlements
MARKETING_VERSION = 1.1.3
// Preserve published build codes when counting only the current branch history.
BUILD_NUMBER_OFFSET = 1000
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 18.0
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64

// xcconfig treats // as a comment, so $() keeps the URL intact.
API_BASE_URL = https:/$()/api.coffeepeek.by
GOOGLE_IOS_CLIENT_ID =
GOOGLE_WEB_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID = coffeepeek-google-signin-disabled

// The shelf in the Coffee tab; turn on in Local.xcconfig for builds whose backend serves the shelf.
SHELF_ENABLED = NO
// Shelf scanner models, downloaded on the first scan; files must match the size and SHA-256 pinned in ShelfScannerFiles.kt.
SHELF_SEGMENTER_URL = https:/$()/github.com/danielgatis/rembg/releases/download/v0.0.0/u2netp.onnx
SHELF_INPAINTER_URL = https:/$()/huggingface.co/andraniksargsyan/migan/resolve/main/migan_pipeline_v2.onnx

// Explicit local opt-in for analytics in Debug builds.
POSTHOG_ENABLE_DEV = NO
POSTHOG_PROJECT_TOKEN =

// A build setting lets both Xcode and the KMP IDE resolve the argument before Gradle starts.
GRADLE_MAX_WORKERS = 6

#include? "Local.xcconfig"
