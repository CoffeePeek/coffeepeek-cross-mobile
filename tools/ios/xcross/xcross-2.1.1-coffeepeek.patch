--- /dev/null
+++ b/packages/xcross/lib/src/shared/compose/swift/xcode_host_sources.dart
@@ -0,0 +1,85 @@
+import 'package:cli_kit/shared/platform/platform_host.dart';
+import 'package:meta/meta.dart';
+import 'package:path/path.dart' as p;
+import 'package:xcross/src/shared/apple/xcodeproj/pbx_parser.dart';
+
+/// Sources in the application target containing [mainFile], including files
+/// outside iosApp that Xcode references through its group hierarchy.
+@internal
+List<String> readXcodeHostSources(
+  HostFileSystemInterface files,
+  String iosAppDir,
+  String mainFile,
+) {
+  final result = <String>{};
+  for (final project in files.directory(iosAppDir).listSync()) {
+    if (!project.path.endsWith('.xcodeproj')) continue;
+    final archive = PbxParser(
+      files.file(p.join(project.path, 'project.pbxproj')).readAsStringSync(),
+    ).parseArchive();
+    final objects = archive['objects']! as Map<String, Object?>;
+    final reader = XcodeSourceLocations(objects, iosAppDir);
+    for (final value in objects.values.whereType<Map<String, Object?>>()) {
+      if (value['isa'] != 'PBXNativeTarget' ||
+          value['productType'] != 'com.apple.product-type.application') {
+        continue;
+      }
+      final sources = reader.targetSources(value);
+      if (sources.any((source) => _ordinary(source) == _ordinary(mainFile))) {
+        result.addAll(sources);
+      }
+    }
+  }
+  return result.toList()..sort();
+}
+
+String _ordinary(String path) =>
+    p.normalize(path.startsWith(r'\\?\') ? path.substring(4) : path);
+
+@internal
+final class XcodeSourceLocations {
+  XcodeSourceLocations(this.objects, this.root) {
+    for (final entry in objects.entries) {
+      final value = object(entry.key);
+      if (value['isa'] != 'PBXGroup' && value['isa'] != 'PBXVariantGroup') {
+        continue;
+      }
+      for (final child in value['children'] as List<Object?>? ?? const []) {
+        parents[child as String] = entry.key;
+      }
+    }
+  }
+  final Map<String, Object?> objects;
+  final String root;
+  final parents = <String, String>{};
+  Map<String, Object?> object(String id) =>
+      objects[id] as Map<String, Object?>? ?? const {};
+
+  String? location(String id, [Set<String> seen = const {}]) {
+    if (seen.contains(id)) throw FormatException('Cyclic Xcode group: $id');
+    final value = object(id);
+    final path = value['path'] as String? ?? '';
+    final tree = value['sourceTree'] ?? '<group>';
+    if (tree == '<absolute>') return path;
+    if (tree == 'SOURCE_ROOT') return p.normalize(p.join(root, path));
+    if (tree != '<group>') return null;
+    final parent = parents[id];
+    final base = parent == null ? root : location(parent, {...seen, id});
+    return base == null ? null : p.normalize(p.join(base, path));
+  }
+
+  List<String> targetSources(Map<String, Object?> target) {
+    final result = <String>[];
+    for (final phaseId in target['buildPhases'] as List<Object?>? ?? const []) {
+      final phase = object(phaseId as String);
+      if (phase['isa'] != 'PBXSourcesBuildPhase') continue;
+      for (final fileId in phase['files'] as List<Object?>? ?? const []) {
+        final reference = object(fileId as String)['fileRef'];
+        if (reference is! String) continue;
+        final source = location(reference);
+        if (source != null && source.endsWith('.swift')) result.add(source);
+      }
+    }
+    return result;
+  }
+}
