+List<String> swiftPmManifestValues(String debugYaml, String flag) {
+  final found = <String>{};
+  for (final match in RegExp(
+    r'^\s*args:\s*(\[.*\])\s*$',
+    multiLine: true,
+  ).allMatches(debugYaml)) {
+    final arguments = (jsonDecode(match.group(1)!) as List<Object?>)
+        .whereType<String>()
+        .where((value) => value != '-Xcc' && value != '-Xfrontend')
+        .toList();
+    for (var index = 0; index < arguments.length; index++) {
+      final value = arguments[index];
+      if (value == flag && index + 1 < arguments.length) {
+        found.add(arguments[++index]);
+      } else if (flag == '-I' && value.startsWith('-I') && value.length > 2) {
+        found.add(value.substring(2));
+      }
+    }
+  }
+  return found.toList();
