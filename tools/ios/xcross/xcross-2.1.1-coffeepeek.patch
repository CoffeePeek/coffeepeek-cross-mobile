+import 'dart:io';
+
+import 'package:cli_kit/composition/native_host.dart';
+import 'package:meta/meta.dart';
+import 'package:path/path.dart' as p;
+import 'package:test/test.dart';
+import 'package:xcross/src/shared/compose/kmp_entry_discovery.dart';
+import 'package:xcross/src/shared/compose/project/kmp_project.dart';
+import 'package:xcross/src/shared/compose/swift/swift_host_paths.dart';
+import 'package:xcross/src/shared/compose/swiftpm/host_package_link.dart';
+
+@internal
+const kotlinHostSource = '''
+import androidx.compose.ui.window.ComposeUIViewController
+fun MainViewController(onReady: () -> Unit): UIViewController {
+    return ComposeUIViewController { App(onReady = onReady) }
+}
+''';
+@internal
+const swiftHostSource = '''
+import SwiftUI
+import ComposeApp
+@main struct CoffeePeekApp: App { var body: some Scene { WindowGroup { EmptyView() } } }
+''';
+
+void main() {
+  test(
+    'forwards SwiftPM header paths and compiler plugins including spaced Windows paths',
+    () {
+      const manifest =
+          r'''args: ["swiftc", "-Xcc", "-I", "-Xcc", "C:\\Package Files\\include", "-I/other", "-Xfrontend", "-load-plugin-executable", "C:\\Tools\\Macros.exe#SwiftUIMacros"]''';
+      expect(swiftPmManifestValues(manifest, '-I'), [
+        r'C:\Package Files\include',
+        '/other',
+      ]);
+      expect(swiftPmManifestValues(manifest, '-load-plugin-executable'), [
+        r'C:\Tools\Macros.exe#SwiftUIMacros',
+      ]);
+    },
+  );
+  test('retains SwiftUI host when it calls a Kotlin UIViewController', () {
+    expect(detectEntry(withSwift: true).kind, KmpEntryKind.swiftApp);
+  });
+  test('retains Kotlin runner when there is no SwiftUI host', () {
+    expect(detectEntry(withSwift: false).kind, KmpEntryKind.runnableApp);
+  });
+  test('includes external Xcode app sources without another target main', () {
+    final entry = detectEntry(withSwift: true, withProject: true);
+    expect(entry.swiftSources, hasLength(2));
+    expect(
+      entry.swiftSources.any((path) => path.endsWith('Bridge.swift')),
+      isTrue,
+    );
+    expect(entry.swiftImports.any((item) => item.module == 'MapLibre'), isTrue);
+  });
+  test('ignores Swift package build cache as application source', () {
+    expect(
+      isSwiftHostSource('iosApp/.build/checkouts/App.swift', projectRoot: '.'),
+      isFalse,
+    );
+  });
+}
+
+@internal
+ComposeEntryResult detectEntry({
+  required bool withSwift,
+  bool withProject = false,
+}) {
+  final root = Directory.systemTemp.createTempSync('xcross-coffeepeek-entry-');
+  final parent = Directory.systemTemp.resolveSymbolicLinksSync();
+  if (!p.isWithin(parent, root.resolveSymbolicLinksSync())) {
+    throw StateError('Unexpected fixture path');
+  }
+  addTearDown(() => root.deleteSync(recursive: true));
+  writeFixture(
+    root,
+    'composeApp/src/iosMain/MainViewController.kt',
+    kotlinHostSource,
+  );
+  if (withSwift) {
+    writeFixture(root, 'iosApp/iosApp/CoffeePeekApp.swift', swiftHostSource);
+  }
+  if (withProject) {
+    writeFixture(root, 'iosXtool/Bridge.swift', 'import MapLibre\n');
+    writeFixture(root, 'iosApp/iosApp/OtherApp.swift', swiftHostSource);
+    writeFixture(root, 'iosApp/iosApp.xcodeproj/project.pbxproj', '''
+{ objects = {
+  group = { isa = PBXGroup; path = iosApp; sourceTree = "<group>"; children = (main, bridge); };
+  main = { isa = PBXFileReference; path = CoffeePeekApp.swift; sourceTree = "<group>"; };
+  bridge = { isa = PBXFileReference; path = ../../iosXtool/Bridge.swift; sourceTree = "<group>"; };
+  mainBuild = { isa = PBXBuildFile; fileRef = main; };
+  bridgeBuild = { isa = PBXBuildFile; fileRef = bridge; };
+  phase = { isa = PBXSourcesBuildPhase; files = (mainBuild, bridgeBuild); };
+  app = { isa = PBXNativeTarget; productType = com.apple.product-type.application; buildPhases = (phase); };
+}; }
+''');
+  }
+  final files = detectPlatformHostSnapshot().host.fileSystem;
+  return KmpEntryDiscovery(
+    files,
+  ).classifyEntry(p.join(root.path, 'composeApp'), root.path, 'ComposeApp');
+}
+
+@internal
+void writeFixture(Directory root, String path, String content) {
+  final file = File(p.join(root.path, path));
+  file.parent.createSync(recursive: true);
+  file.writeAsStringSync(content);
+}
