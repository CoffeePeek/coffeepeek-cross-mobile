+  int _skipBlockComment(int start, int end) {
+    var cursor = start + 2;
+    var depth = 1;
+    while (cursor < end && depth > 0) {
+      if (source.startsWith('/*', cursor)) {
+        depth++;
+        cursor += 2;
+      } else if (source.startsWith('*/', cursor)) {
+        depth--;
+        cursor += 2;
+      } else {
+        cursor++;
+      }
     }
     return cursor;
   }
